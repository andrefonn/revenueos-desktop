{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Revenue OS",
  "version": "0.1.0",
  "identifier": "br.app.revenueos.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "capabilities": [],
      "csp": "default-src 'self'; img-src 'self'; style-src 'self'; script-src 'self'; connect-src 'none'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "Revenue OS",
    "category": "Business",
    "shortDescription": "Sua operação comercial no computador",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "PortugueseBR"
        ],
        "displayLanguageSelector": false,
        "startMenuFolder": "Revenue OS"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk5MTk0MEMwQkJCMEI1OEQKUldTTnRiQzd3RUFabWM1WkltVUkvYXZYVVlFQkgvREY0V21UM3BRUTlKaDgwZkxoSy9BTEZzRFQK",
      "endpoints": [
        "https://github.com/andrefonn/revenueos-desktop/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
